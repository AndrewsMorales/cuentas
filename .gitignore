# SQLite: ni la base ni sus temporales viajan en git.
# La base local tiene ingresos y gastos reales del hogar; en un repositorio
# público eso es una filtración. Para arrancar de cero: php artisan migrate --seed
/database/*.sqlite
/database/*.sqlite.bak*
/database/*.sqlite-journal
/database/*.sqlite-wal
/database/*.sqlite-shm

# Caché y artefactos de runtime
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
/storage/logs/*

# Backups locales (no contaminan el repo)
/backups
*.sqlite.gz
